# Copy to .env and adjust. All settings have working defaults; nothing here is
# required for the local (zero-setup) mode.

# --- Frame extraction ---
# FRAMEGUARD_FRAME_BACKEND=ffmpeg      # ffmpeg (default) | opencv
# FRAMEGUARD_FFMPEG_BIN=ffmpeg
# FRAMEGUARD_FFPROBE_BIN=ffprobe
# FRAMEGUARD_ALLOWED_FPS=15,30
# FRAMEGUARD_DEFAULT_FPS=30

# --- Storage ---
# FRAMEGUARD_DATA_DIR=./data
# FRAMEGUARD_MAX_UPLOAD_BYTES=524288000  # 500 MB

# --- AI content detection (verify time) ---
# FRAMEGUARD_AI_BACKEND=none             # none | heuristic | efficientnet
# FRAMEGUARD_AI_WEIGHTS=/path/to/efficientnet_b4.pt
# FRAMEGUARD_AI_DEVICE=cpu
# FRAMEGUARD_CRYPTO_WEIGHT=0.6           # hybrid = crypto_weight*crypto + (1-weight)*ai

# --- Off-chain IPFS storage (register time) ---
# FRAMEGUARD_STORAGE_BACKEND=none        # none | pinata | ipfs
# FRAMEGUARD_PINATA_JWT=                 # required for the pinata backend
# FRAMEGUARD_IPFS_API=http://127.0.0.1:5001   # local Kubo node (ipfs backend)
# FRAMEGUARD_IPFS_GATEWAY=https://ipfs.io/ipfs/

# --- Anchoring ---
# FRAMEGUARD_ANCHOR_BACKEND=local        # local (hash-chained ledger) | chain
# Required only when ANCHOR_BACKEND=chain:
# FRAMEGUARD_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# FRAMEGUARD_CONTRACT_ADDRESS=0x...
# FRAMEGUARD_PRIVATE_KEY=0x...           # keep this secret; never commit it
# FRAMEGUARD_CHAIN_ID=11155111
